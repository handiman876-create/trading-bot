[Unit]
Description=S&P 500 constituent refresh — rewrites data/sp500.json (momentum-screen universe)
Documentation=file:/root/trading-bot/deploy/run-refresh-sp500.sh
After=network-online.target
Wants=network-online.target

[Service]
# oneshot: run to completion, then exit (the .timer schedules it; not a daemon).
Type=oneshot
User=root
WorkingDirectory=/root/trading-bot
ExecStart=/root/trading-bot/deploy/run-refresh-sp500.sh
# One HTTP GET against raw.githubusercontent.com — no rate-limited vendor API,
# so this is fast. Cap generously anyway so a GitHub stall can't wedge the run.
TimeoutStartSec=300
StandardOutput=append:/root/trading-bot/logs/momentum.log
StandardError=append:/root/trading-bot/logs/momentum.log

# No [Install] section: a timer-activated oneshot is pulled in by its .timer,
# not enabled directly.
